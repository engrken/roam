generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("ROAMDB_POSTGRES_PRISMA_URL")
  directUrl = env("ROAMDB_DATABASE_URL_UNPOOLED")
}

enum TenantStatus {\n  TRIAL\n  ACTIVE\n  SUSPENDED\n  CANCELLED\n}
enum SubscriptionTier {\n  FREE\n  PRO\n  ENTERPRISE\n}
enum MembershipRole {\n  OWNER\n  ADMIN\n  MANAGER\n  STAFF\n}
enum VehicleStatus {\n  AVAILABLE\n  RESERVED\n  RENTED\n  MAINTENANCE\n  INACTIVE\n}
enum BookingStatus {\n  PENDING\n  CONFIRMED\n  ACTIVE\n  COMPLETED\n  CANCELLED\n  REJECTED\n}
enum VehicleType {\n  MOTORCYCLE\n  SCOOTER\n  SEDAN\n  HATCHBACK\n  SUV\n  MPV\n  VAN\n  PICKUP\n  BUS\n  TRUCK\n  OTHER\n}

model Tenant {
  id           String       @id @default(cuid())
  name         String
  slug         String       @unique
  email        String
  phone        String?
  status       TenantStatus @default(TRIAL)
  timezone     String       @default("Asia/Manila")
  currency     String       @default("PHP")
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt
  memberships  Membership[]
  branches     Branch[]
  vehicles     Vehicle[]
  customers    Customer[]
  bookings     Booking[]
  subscription Subscription?
}

model User {
  id          String       @id @default(cuid())
  email       String       @unique
  name        String?
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
  memberships Membership[]
}

model Membership {
  id        String         @id @default(cuid())
  tenantId  String
  userId    String
  role      MembershipRole @default(STAFF)
  createdAt DateTime       @default(now())
  tenant    Tenant         @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  user      User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@unique([tenantId, userId])
  @@index([userId])
  @@index([tenantId, role])
}

model Plan {
  id             String           @id @default(cuid())
  tier           SubscriptionTier @unique
  name           String
  monthlyPrice   Decimal          @db.Decimal(12, 2)
  maxVehicles    Int?
  maxBranches    Int?
  maxStaff       Int?
  active         Boolean          @default(true)
  subscriptions Subscription[]
}

model Subscription {
  id                 String           @id @default(cuid())
  tenantId           String           @unique
  planId             String
  tier               SubscriptionTier @default(FREE)
  status             String           @default("active")
  currentPeriodStart DateTime?
  currentPeriodEnd   DateTime?
  createdAt          DateTime         @default(now())
  updatedAt          DateTime         @updatedAt
  tenant             Tenant           @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  plan               Plan             @relation(fields: [planId], references: [id])
}

model Branch {
  id        String   @id @default(cuid())
  tenantId  String
  name      String
  code      String?
  address   String?
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  tenant    Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  vehicles  Vehicle[]
  bookings  Booking[]
  @@unique([tenantId, code])
  @@index([tenantId])
}

model Vehicle {
  id              String        @id @default(cuid())
  tenantId        String
  branchId        String?
  type            VehicleType
  make            String
  model           String
  year            Int?
  plateNumber     String
  color           String?
  seats           Int?
  transmission    String?
  dailyRate       Decimal       @db.Decimal(12, 2)
  securityDeposit Decimal       @default(0) @db.Decimal(12, 2)
  status          VehicleStatus @default(AVAILABLE)
  notes           String?
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt
  tenant          Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  branch          Branch?       @relation(fields: [branchId], references: [id], onDelete: SetNull)
  bookingItems    BookingItem[]
  @@unique([tenantId, plateNumber])
  @@index([tenantId, status])
  @@index([tenantId, branchId])
}

model Customer {
  id        String   @id @default(cuid())
  tenantId  String
  name      String
  email     String?
  phone     String
  licenseNo String?
  address   String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  tenant    Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  bookings  Booking[]
  @@index([tenantId, phone])
  @@index([tenantId, email])
}

model Booking {
  id          String        @id @default(cuid())
  tenantId    String
  branchId    String?
  customerId  String
  reference   String
  status      BookingStatus @default(PENDING)
  startAt     DateTime
  endAt       DateTime
  totalAmount Decimal       @db.Decimal(12, 2)
  notes       String?
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt
  tenant      Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  branch      Branch?       @relation(fields: [branchId], references: [id], onDelete: SetNull)
  customer    Customer      @relation(fields: [customerId], references: [id])
  items       BookingItem[]
  @@unique([tenantId, reference])
  @@index([tenantId, startAt, endAt])
  @@index([tenantId, status])
}

model BookingItem {
  id        String   @id @default(cuid())
  bookingId String
  vehicleId String
  rate      Decimal  @db.Decimal(12, 2)
  booking   Booking  @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  vehicle   Vehicle  @relation(fields: [vehicleId], references: [id])
  @@unique([bookingId, vehicleId])
  @@index([vehicleId])
}
