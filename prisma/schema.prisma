generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("ROAMDB_POSTGRES_PRISMA_URL")
  directUrl = env("ROAMDB_DATABASE_URL_UNPOOLED")
}

enum TenantStatus {
  TRIAL
  ACTIVE
  SUSPENDED
  CANCELLED
}
enum SubscriptionTier {
  FREE
  STARTER
  PRO
  BUSINESS
  ENTERPRISE
}
enum MembershipRole {
  OWNER
  ADMIN
  MANAGER
  STAFF
}
enum VehicleStatus {
  AVAILABLE
  RESERVED
  RENTED
  MAINTENANCE
  INACTIVE
}
enum BookingStatus {
  PENDING
  CONFIRMED
  ACTIVE
  COMPLETED
  CANCELLED
  REJECTED
}
enum InspectionType {
  HANDOVER
  RETURN
}
enum FuelLevel {
  EMPTY
  QUARTER
  HALF
  THREE_QUARTERS
  FULL
}
enum VehicleType {
  MOTORCYCLE
  SCOOTER
  SEDAN
  HATCHBACK
  SUV
  MPV
  VAN
  PICKUP
  BUS
  TRUCK
  OTHER
}

enum MarketplaceLeadType {
  HOST
  RENTER
}

enum MarketplaceLeadStatus {
  NEW
  CONTACTED
  QUALIFIED
  WAITLISTED
  ARCHIVED
}

enum MarketplaceHostStatus {
  DRAFT
  SUBMITTED
  IN_REVIEW
  NEEDS_INFORMATION
  PREQUALIFIED
  DECLINED
  SUSPENDED
}

enum MarketplaceListingStatus {
  DRAFT
  SUBMITTED
  IN_REVIEW
  NEEDS_INFORMATION
  PREQUALIFIED
  DECLINED
  SUSPENDED
}

enum MarketplaceHostEmailStatus {
  PENDING
  SENDING
  SENT
  FAILED
}

model Tenant {
  id           String       @id @default(cuid())
  name         String
  slug         String       @unique
  email        String
  phone        String?
  rentalTerms  String?      @db.Text
  status       TenantStatus @default(TRIAL)
  timezone     String       @default("Asia/Manila")
  currency     String       @default("PHP")
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt
  memberships  Membership[]
  branches     Branch[]
  vehicles     Vehicle[]
  customers    Customer[]
  bookings     Booking[]
  inspections  VehicleInspection[]
  subscription Subscription?
  invitations  TeamInvitation[]
  billingRecords BillingRecord[]
  subscriptionRefunds SubscriptionRefund[]
  referralCode String @unique
  referralsSent Referral[] @relation("ReferralReferrer")
  referralReceived Referral? @relation("ReferralReferredTenant")
  referredUsers User[] @relation("UserReferredByTenant")
  rentalPayments RentalPayment[]
  tenantPaymentMethods TenantPaymentMethod[]
  rentalPaymentSubmissions RentalPaymentSubmission[]
  vehicleMaintenances VehicleMaintenance[]
  vehicleServiceRecords VehicleServiceRecord[]
  operatingExpenses OperatingExpense[]
  subscriptionChangeRequests SubscriptionChangeRequest[]
  subscriptionPaymentSubmissions SubscriptionPaymentSubmission[]
  marketplaceHostProfile MarketplaceHostProfile?
  marketplaceListings MarketplaceListing[]
  marketplaceRentalQuotes MarketplaceRentalQuote[]
  marketplaceHostNotifications MarketplaceHostNotification[]
  webPushSubscriptions WebPushSubscription[]
}

model User {
  id          String       @id @default(cuid())
  email       String       @unique
  name        String?
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
  memberships Membership[]
  sessions    Session[]
  legalAcceptances LegalAcceptance[]
  referredByTenantId String?
  referredByTenant Tenant? @relation("UserReferredByTenant", fields: [referredByTenantId], references: [id], onDelete: SetNull)
  referredReferral Referral? @relation("ReferralReferredOwner")
  @@index([referredByTenantId])
}

model Membership {
  id        String         @id @default(cuid())
  tenantId  String
  userId    String
  role      MembershipRole @default(STAFF)
  createdAt DateTime       @default(now())
  tenant    Tenant         @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  user      User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@unique([tenantId, userId])
  @@index([userId])
  @@index([tenantId, role])
}

model Plan {
  id             String           @id @default(cuid())
  tier           SubscriptionTier @unique
  name           String
  monthlyPrice   Decimal          @db.Decimal(12, 2)
  maxVehicles    Int?
  maxBranches    Int?
  maxStaff       Int?
  active         Boolean          @default(true)
  subscriptions Subscription[]
}

model Subscription {
  id                 String           @id @default(cuid())
  tenantId           String           @unique
  planId             String
  tier               SubscriptionTier @default(FREE)
  status             String           @default("active")
  currentPeriodStart DateTime?
  currentPeriodEnd   DateTime?
  trialEndsAt        DateTime?
  trialPolicyVersion Int              @default(0)
  trialGraceEndsAt   DateTime?
  trialReminderSentAt DateTime?
  trialExpiredNoticeSentAt DateTime?
  trialReadOnlyNoticeSentAt DateTime?
  renewalReminderSentAt DateTime?
  renewalOverdueNoticeSentAt DateTime?
  referralCreditMonths Int @default(0)
  createdAt          DateTime         @default(now())
  updatedAt          DateTime         @updatedAt
  tenant             Tenant           @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  plan               Plan             @relation(fields: [planId], references: [id])
}

model Branch {
  id        String   @id @default(cuid())
  tenantId  String
  name      String
  code      String?
  address   String?
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  tenant    Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  vehicles  Vehicle[]
  bookings  Booking[]
  operatingExpenses OperatingExpense[]
  @@unique([tenantId, code])
  @@index([tenantId])
}

model Vehicle {
  id              String        @id @default(cuid())
  tenantId        String
  branchId        String?
  type            VehicleType
  make            String
  model           String
  year            Int?
  plateNumber     String
  color           String?
  seats           Int?
  transmission    String?
  dailyRate       Decimal       @db.Decimal(12, 2)
  securityDeposit Decimal       @default(0) @db.Decimal(12, 2)
  status          VehicleStatus @default(AVAILABLE)
  notes           String?
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt
  tenant          Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  branch          Branch?       @relation(fields: [branchId], references: [id], onDelete: SetNull)
  bookingItems    BookingItem[]
  inspections     VehicleInspection[]
  maintenances    VehicleMaintenance[]
  serviceRecords  VehicleServiceRecord[]
  operatingExpenses OperatingExpense[]
  marketplaceListing MarketplaceListing?
  @@unique([tenantId, plateNumber])
  @@unique([id, tenantId])
  @@index([tenantId, status])
  @@index([tenantId, branchId])
}

model Customer {
  id        String   @id @default(cuid())
  tenantId  String
  name      String
  email     String?
  phone     String
  licenseNo String?
  address   String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  tenant    Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  bookings  Booking[]
  @@index([tenantId, phone])
  @@index([tenantId, email])
}

model Booking {
  id          String        @id @default(cuid())
  tenantId    String
  branchId    String?
  customerId  String
  reference   String
  status      BookingStatus @default(PENDING)
  startAt     DateTime
  endAt       DateTime
  totalAmount Decimal       @db.Decimal(12, 2)
  securityDeposit Decimal   @default(0) @db.Decimal(12, 2)
  notes       String?
  rentalTermsSnapshot String? @db.Text
  rentalTermsVersion String?
  rentalTermsAcceptedAt DateTime?
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt
  tenant      Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  branch      Branch?       @relation(fields: [branchId], references: [id], onDelete: SetNull)
  customer    Customer      @relation(fields: [customerId], references: [id])
  items       BookingItem[]
  messages    BookingMessage[]
  payments    RentalPayment[]
  rentalPaymentSubmissions RentalPaymentSubmission[]
  automationNotices BookingAutomationNotice[]
  webPushSubscriptions WebPushSubscription[]
  documents   BookingDocument[]
  inspections VehicleInspection[]
  publicTokenHash String? @unique
  @@unique([tenantId, reference])
  @@index([tenantId, startAt, endAt])
  @@index([tenantId, status])
}

model BookingItem {
  id        String   @id @default(cuid())
  bookingId String
  vehicleId String
  rate      Decimal  @db.Decimal(12, 2)
  booking   Booking  @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  vehicle   Vehicle  @relation(fields: [vehicleId], references: [id])
  @@unique([bookingId, vehicleId])
  @@index([vehicleId])
}


model EmailOtp {
  id         String   @id @default(cuid())
  email      String
  codeHash   String
  expiresAt  DateTime
  attempts   Int      @default(0)
  consumedAt DateTime?
  referralCode String?
  createdAt  DateTime @default(now())
  @@index([email, createdAt])
  @@index([expiresAt])
}

model Session {
  id        String   @id @default(cuid())
  tokenHash String   @unique
  userId    String
  expiresAt DateTime
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@index([userId, expiresAt])
  @@index([expiresAt])
}

model BookingMessage {
  id        String   @id @default(cuid())
  bookingId String
  sender    String
  body      String
  createdAt DateTime @default(now())
  booking   Booking  @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  @@index([bookingId, createdAt])
}

model BookingDocument {
  id           String   @id @default(cuid())
  bookingId    String
  kind         String
  pathname     String   @unique
  fileName     String
  contentType  String
  size         Int
  reviewStatus String   @default("PENDING")
  reviewedAt   DateTime?
  createdAt    DateTime @default(now())
  booking      Booking  @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  @@index([bookingId, reviewStatus])
}


model VehicleInspection {
  id             String           @id @default(cuid())
  tenantId       String
  bookingId      String
  vehicleId      String
  type           InspectionType
  odometerKm     Int
  fuelLevel      FuelLevel
  conditionNotes String
  damageNotes    String?
  inspectedAt    DateTime         @default(now())
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt
  tenant         Tenant           @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  booking        Booking          @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  vehicle        Vehicle          @relation(fields: [vehicleId], references: [id])
  photos         VehicleInspectionPhoto[]
  @@unique([bookingId, vehicleId, type])
  @@index([tenantId, inspectedAt])
  @@index([vehicleId, inspectedAt])
}

model VehicleInspectionPhoto {
  id           String           @id @default(cuid())
  inspectionId String
  pathname     String           @unique
  fileName     String
  contentType  String
  size         Int
  createdAt    DateTime         @default(now())
  inspection   VehicleInspection @relation(fields: [inspectionId], references: [id], onDelete: Cascade)
  @@index([inspectionId, createdAt])
}


model LegalAcceptance {
  id             String   @id @default(cuid())
  userId         String
  termsVersion   String
  privacyVersion String
  acceptedAt     DateTime @default(now())
  ipAddress      String?
  userAgent      String?
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@unique([userId, termsVersion, privacyVersion])
  @@index([userId, acceptedAt])
}


model TeamInvitation {
  id              String         @id @default(cuid())
  tenantId        String
  email           String
  role            MembershipRole @default(STAFF)
  tokenHash       String         @unique
  invitedByUserId String
  expiresAt       DateTime
  acceptedAt      DateTime?
  createdAt       DateTime       @default(now())
  tenant          Tenant         @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId, email, acceptedAt])
  @@index([expiresAt])
}

model PlatformAuditLog {
  id          String   @id @default(cuid())
  actorUserId String
  actorEmail  String
  action      String
  entityType  String
  entityId    String
  details     Json?
  createdAt   DateTime @default(now())

  @@index([createdAt])
  @@index([actorUserId, createdAt])
  @@index([entityType, entityId, createdAt])
}



model Referral {
  id                 String   @id @default(cuid())
  referrerTenantId   String
  referredTenantId   String   @unique
  referredOwnerUserId String  @unique
  code               String
  status             String   @default("PENDING")
  registeredAt       DateTime
  expiresAt          DateTime
  qualifiedAt        DateTime?
  rewardedAt         DateTime?
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt
  referrerTenant     Tenant   @relation("ReferralReferrer", fields: [referrerTenantId], references: [id], onDelete: Cascade)
  referredTenant     Tenant   @relation("ReferralReferredTenant", fields: [referredTenantId], references: [id], onDelete: Cascade)
  referredOwner      User     @relation("ReferralReferredOwner", fields: [referredOwnerUserId], references: [id], onDelete: Cascade)
  @@index([referrerTenantId, status, createdAt])
  @@index([status, expiresAt])
}

model BillingRecord {
  id          String   @id @default(cuid())
  tenantId    String
  description String
  reference   String?  @unique
  amount      Decimal  @db.Decimal(12, 2)
  currency    String   @default("PHP")
  status      String   @default("PENDING")
  issuedAt    DateTime @default(now())
  dueAt       DateTime?
  paidAt      DateTime?
  createdAt   DateTime @default(now())
  tenant      Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  refunds     SubscriptionRefund[]
  @@index([tenantId, issuedAt])
  @@index([tenantId, status])
}

model SubscriptionRefund {
  id             String   @id @default(cuid())
  tenantId       String
  billingRecordId String
  amount         Decimal  @db.Decimal(12, 2)
  currency       String   @default("PHP")
  method         String
  reference      String?
  reason         String   @db.Text
  reasonCategory String?
  status         String   @default("PENDING")
  recordedById   String
  completedById  String?
  completedAt    DateTime?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  tenant         Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  billingRecord  BillingRecord @relation(fields: [billingRecordId], references: [id], onDelete: Cascade)
  @@index([tenantId, createdAt])
  @@index([status, createdAt])
  @@index([billingRecordId, status])
}

model SubscriptionChangeRequest {
  id             String   @id @default(cuid())
  tenantId       String
  requestedTier  SubscriptionTier
  currentTier    SubscriptionTier
  status         String   @default("PENDING")
  note           String?  @db.Text
  requestedById  String
  reviewedById   String?
  reviewedAt     DateTime?
  createdAt      DateTime @default(now())
  tenant         Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  @@index([tenantId, createdAt])
  @@index([status, createdAt])
}



model SubscriptionPaymentMethod {
  id             String   @id @default(cuid())
  key            String   @unique
  label          String
  accountName    String?
  instructions   String?  @db.Text
  qrImageData    String?  @db.Text
  qrContentType  String?
  enabled        Boolean  @default(false)
  sortOrder      Int      @default(0)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  submissions    SubscriptionPaymentSubmission[]
}

model SubscriptionPaymentSubmission {
  id                         String   @id @default(cuid())
  tenantId                   String
  methodId                   String
  methodLabel                String
  accountName                String?
  reference                  String
  amount                     Decimal  @db.Decimal(12, 2)
  paidAt                     DateTime
  receiptData                String?  @db.Text
  receiptContentType         String?
  status                     String   @default("PENDING")
  provisionalUntil           DateTime
  previousTenantStatus       TenantStatus
  previousSubscriptionStatus String
  previousCurrentPeriodStart DateTime?
  previousCurrentPeriodEnd   DateTime?
  previousTrialEndsAt        DateTime?
  previousTrialGraceEndsAt   DateTime?
  reviewedById               String?
  reviewedAt                 DateTime?
  rejectionReason            String?  @db.Text
  createdAt                  DateTime @default(now())
  updatedAt                  DateTime @updatedAt
  tenant                     Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  method                     SubscriptionPaymentMethod @relation(fields: [methodId], references: [id], onDelete: Restrict)
  @@unique([methodId, reference])
  @@index([status, provisionalUntil])
  @@index([tenantId, createdAt])
}

model RentalPayment {
  id        String   @id @default(cuid())
  tenantId  String
  bookingId String
  amount    Decimal  @db.Decimal(12, 2)
  currency  String   @default("PHP")
  method    String   @default("CASH")
  kind      String   @default("PAYMENT")
  reference String?
  notes     String?  @db.Text
  receivedAt DateTime @default(now())
  createdAt DateTime @default(now())
  submission RentalPaymentSubmission?
  tenant    Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  booking   Booking  @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  @@index([tenantId, receivedAt])
  @@index([bookingId, receivedAt])
}

model TenantPaymentMethod {
  id             String   @id @default(cuid())
  tenantId       String
  method         String
  label          String
  accountName    String?
  accountNumber  String?
  bankName       String?
  instructions   String?  @db.Text
  qrImageData    String?  @db.Text
  qrContentType  String?
  enabled        Boolean  @default(false)
  sortOrder      Int      @default(0)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  tenant         Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  submissions    RentalPaymentSubmission[]
  @@unique([tenantId, method])
  @@index([tenantId, enabled, sortOrder])
}

model RentalPaymentSubmission {
  id                  String   @id @default(cuid())
  tenantId            String
  bookingId           String
  paymentMethodId     String
  methodLabelSnapshot String
  accountNameSnapshot String?
  accountNumberSnapshot String?
  bankNameSnapshot    String?
  reference           String
  amount              Decimal  @db.Decimal(12, 2)
  currency            String   @default("PHP")
  paidAt              DateTime
  proofPathname       String?
  customerNote        String?  @db.Text
  status              String   @default("PENDING")
  reviewedById        String?
  reviewedAt          DateTime?
  rejectionReason     String?  @db.Text
  rentalPaymentId     String?  @unique
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt
  tenant              Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  booking             Booking  @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  paymentMethod       TenantPaymentMethod @relation(fields: [paymentMethodId], references: [id], onDelete: Restrict)
  rentalPayment       RentalPayment? @relation(fields: [rentalPaymentId], references: [id], onDelete: SetNull)
  @@unique([paymentMethodId, reference])
  @@index([tenantId, status, createdAt])
  @@index([bookingId, createdAt])
}

model BookingAutomationNotice {
  id           String   @id @default(cuid())
  bookingId    String
  noticeKey    String   @unique
  noticeType   String
  status       String   @default("PENDING")
  scheduledFor DateTime
  sentAt       DateTime?
  lastError    String?  @db.Text
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  booking      Booking  @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  @@index([status, scheduledFor])
}


model VehicleMaintenance {
  id          String   @id @default(cuid())
  tenantId    String
  vehicleId   String
  title       String
  description String?  @db.Text
  status      String   @default("SCHEDULED")
  startAt     DateTime
  endAt       DateTime
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  tenant      Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  vehicle     Vehicle  @relation(fields: [vehicleId], references: [id], onDelete: Cascade)
  serviceRecords VehicleServiceRecord[]
  @@index([tenantId, startAt, endAt])
  @@index([vehicleId, startAt, endAt])
}

model VehicleServiceRecord {
  id           String   @id @default(cuid())
  tenantId     String
  vehicleId    String
  maintenanceId String?
  serviceType  String
  description  String?  @db.Text
  odometerKm   Int?
  cost         Decimal  @default(0) @db.Decimal(12, 2)
  performedAt  DateTime @default(now())
  createdAt    DateTime @default(now())
  tenant       Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  vehicle      Vehicle  @relation(fields: [vehicleId], references: [id], onDelete: Cascade)
  maintenance  VehicleMaintenance? @relation(fields: [maintenanceId], references: [id], onDelete: SetNull)
  @@index([tenantId, performedAt])
  @@index([vehicleId, performedAt])
}

model OperatingExpense {
  id          String   @id @default(cuid())
  tenantId    String
  branchId    String?
  vehicleId   String?
  category    String
  description String
  amount      Decimal  @db.Decimal(12, 2)
  currency    String   @default("PHP")
  incurredAt  DateTime @default(now())
  reference   String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  tenant      Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  branch      Branch?  @relation(fields: [branchId], references: [id], onDelete: SetNull)
  vehicle     Vehicle? @relation(fields: [vehicleId], references: [id], onDelete: SetNull)
  @@index([tenantId, incurredAt])
  @@index([tenantId, category, incurredAt])
  @@index([vehicleId, incurredAt])
}

model MarketplaceLead {
  id               String                @id @default(cuid())
  type             MarketplaceLeadType
  status           MarketplaceLeadStatus @default(NEW)
  fullName         String
  email            String
  phone            String?
  city             String
  providerType     String?
  vehicleCategory  String?
  contactConsentAt DateTime
  consentVersion   String
  createdAt        DateTime              @default(now())
  updatedAt        DateTime              @updatedAt

  @@unique([type, email])
  @@index([type, status, createdAt])
  @@index([createdAt])
}


model MarketplaceHostProfile {
  id            String               @id @default(cuid())
  tenantId      String               @unique
  providerType  String
  displayName   String
  description   String?              @db.Text
  email         String
  phone         String?
  city          String
  province      String?
  status        MarketplaceHostStatus @default(DRAFT)
  submittedAt   DateTime?
  reviewedAt    DateTime?
  internalNotes String?              @db.Text
  hostMessage   String?              @db.Text
  createdAt     DateTime             @default(now())
  updatedAt     DateTime             @updatedAt
  tenant        Tenant               @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  listings      MarketplaceListing[]
  @@unique([id, tenantId])
  @@index([status, submittedAt])
}

model MarketplaceListing {
  id            String                   @id @default(cuid())
  tenantId      String
  hostProfileId String
  vehicleId     String                   @unique
  headline      String
  description   String?                  @db.Text
  status        MarketplaceListingStatus @default(DRAFT)
  isPublished   Boolean                  @default(false)
  submittedAt   DateTime?
  reviewedAt    DateTime?
  internalNotes String?                  @db.Text
  hostMessage   String?                  @db.Text
  createdAt     DateTime                 @default(now())
  updatedAt     DateTime                 @updatedAt
  tenant        Tenant                   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  hostProfile   MarketplaceHostProfile   @relation(fields: [hostProfileId, tenantId], references: [id, tenantId], onDelete: Cascade)
  vehicle       Vehicle                  @relation(fields: [vehicleId, tenantId], references: [id, tenantId], onDelete: Cascade)
  availabilityBlocks MarketplaceAvailabilityBlock[]
  bookingInquiries MarketplaceBookingInquiry[]
  @@unique([vehicleId, tenantId])
  @@unique([id, tenantId])
  @@index([tenantId, status, createdAt])
  @@index([status, submittedAt])
}



model MarketplaceAvailabilityBlock {
  id        String   @id @default(cuid())
  tenantId  String
  listingId String
  startAt   DateTime
  endAt     DateTime
  label     String?  @db.VarChar(100)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  listing   MarketplaceListing @relation(fields: [listingId, tenantId], references: [id, tenantId], onDelete: Cascade)
  @@index([tenantId, startAt, endAt])
  @@index([listingId, startAt, endAt])
}

model MarketplaceBookingInquiry {
  id                  String   @id @default(cuid())
  tenantId            String
  listingId           String
  requesterName       String   @db.VarChar(120)
  requesterEmail      String   @db.VarChar(254)
  requesterPhone      String?  @db.VarChar(40)
  startAt             DateTime
  endAt               DateTime
  dailyRateSnapshot   Decimal  @db.Decimal(12, 2)
  message              String?  @db.Text
  status               String   @default("NEW")
  hostNote             String?  @db.Text
  contactConsentAt     DateTime
  consentVersion       String
  reviewedAt           DateTime?
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt
  listing              MarketplaceListing @relation(fields: [listingId, tenantId], references: [id, tenantId], onDelete: Cascade)
  rentalQuotes         MarketplaceRentalQuote[]
  @@unique([id, tenantId])
  @@index([tenantId, status, createdAt])
  @@index([listingId, startAt, endAt])
  @@index([listingId, requesterEmail, createdAt])
}

model MarketplaceHostNotification {
  id             String                       @id @default(cuid())
  tenantId       String
  targetType     String
  targetId       String
  status         String
  title          String
  message        String                       @db.Text
  recipientEmail String
  recipientName  String
  emailStatus    MarketplaceHostEmailStatus  @default(PENDING)
  emailSentAt    DateTime?
  emailError     String?                      @db.Text
  createdAt      DateTime                     @default(now())
  updatedAt      DateTime                     @updatedAt
  tenant         Tenant                       @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId, createdAt])
  @@index([emailStatus, createdAt])
  @@index([targetType, targetId, createdAt])
}


model MarketplaceRentalQuote {
  id                    String   @id @default(cuid())
  tenantId              String
  inquiryId             String
  version               Int
  status                String   @default("DRAFT")
  currency              String   @default("PHP") @db.VarChar(3)
  dailyRate             Decimal  @db.Decimal(12, 2)
  rentalDays            Int
  baseAmount            Decimal  @db.Decimal(12, 2)
  addOns                Json
  discountAmount        Decimal  @db.Decimal(12, 2)
  fees                  Json
  totalAmount           Decimal  @db.Decimal(12, 2)
  validUntil            DateTime
  snapshot              Json
  agreementReference    String?  @db.VarChar(160)
  agreementReviewedAt   DateTime?
  agreementReviewedById String?
  approvedAt            DateTime?
  approvedById          String?
  acceptanceTokenHash   String?  @unique
  acceptanceLinkCreatedAt DateTime?
  renterAcceptedAt      DateTime?
  renterAcceptedName    String?  @db.VarChar(120)
  renterAcceptedEmail   String?  @db.VarChar(254)
  createdById           String
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt
  inquiry               MarketplaceBookingInquiry @relation(fields: [inquiryId, tenantId], references: [id, tenantId], onDelete: Cascade)
  tenant                Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  @@unique([inquiryId, tenantId, version])
  @@unique([id, tenantId])
  @@index([tenantId, status, createdAt])
}


model WebPushSubscription {
  id        String   @id @default(cuid())
  endpoint  String   @unique @db.Text
  p256dh    String
  auth      String
  tenantId  String?
  bookingId String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  tenant    Tenant?  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  booking   Booking? @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  @@index([tenantId])
  @@index([bookingId])
}
