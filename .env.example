# Neon Marketplace integration variables
# These are created automatically in Vercel when the Neon database is connected.
# For local development, copy the matching values from your Neon dashboard.
ROAMDB_POSTGRES_PRISMA_URL=""
ROAMDB_DATABASE_URL_UNPOOLED=""

# Application URL
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Gmail SMTP — create a Google App Password with 2-Step Verification enabled.
# Never use your normal Gmail account password here or commit real credentials.
SMTP_HOST="smtp.gmail.com"
SMTP_PORT="587"
SMTP_SECURE="false"
SMTP_USER=""
SMTP_APP_PASSWORD=""
SMTP_FROM="ROAM <your-gmail-address@gmail.com>"

# Auth/session secrets — generate strong random values before deployment
AUTH_SECRET=""

# PayMongo QR Ph subscription payments
# Use test keys in Preview and live keys in Production.
# Keep the secret key and webhook secret server-side; only the public key is exposed to the browser.
PAYMONGO_SECRET_KEY=""
NEXT_PUBLIC_PAYMONGO_PUBLIC_KEY=""
PAYMONGO_WEBHOOK_SECRET=""
