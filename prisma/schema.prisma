generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("ROAMDB_POSTGRES_PRISMA_URL")
  directUrl = env("ROAMDB_DATABASE_URL_UNPOOLED")
}

enum TenantStatus {
  TRIAL
  ACTIVE
  SUSPENDED
  CANCELLED
}
enum SubscriptionTier {
  FREE
  STARTER
  PRO
  BUSINESS
  ENTERPRISE
}
enum MembershipRole {
  OWNER
  ADMIN
  MANAGER
  STAFF
}
enum VehicleStatus {
  AVAILABLE
  RESERVED
  RENTED
  MAINTENANCE
  INACTIVE
}
enum BookingStatus {
  PENDING
  CONFIRMED
  ACTIVE
  COMPLETED
  CANCELLED
  REJECTED
}
enum InspectionType {
  HANDOVER
  RETURN
}
enum FuelLevel {
  EMPTY
  QUARTER
  HALF
  THREE_QUARTERS
  FULL
}
enum VehicleType {
  MOTORCYCLE
  SCOOTER
  SEDAN
  HATCHBACK
  SUV
  MPV
  VAN
  PICKUP
  BUS
  TRUCK
  OTHER
}

model Tenant {
  id           String       @id @default(cuid())
  name         String
  slug         String       @unique
  email        String
  phone        String?
  rentalTerms  String?      @db.Text
  status       TenantStatus @default(TRIAL)
  timezone     String       @default("Asia/Manila")
  currency     String       @default("PHP")
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt
  memberships  Membership[]
  branches     Branch[]
  vehicles     Vehicle[]
  customers    Customer[]
  bookings     Booking[]
  inspections  VehicleInspection[]
  subscription Subscription?
  invitations  TeamInvitation[]
  billingRecords BillingRecord[]
