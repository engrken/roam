generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("ROAMDB_POSTGRES_PRISMA_URL")
  directUrl = env("ROAMDB_DATABASE_URL_UNPOOLED")
}

enum TenantStatus {
  TRIAL
  ACTIVE
  SUSPENDED
  CANCELLED
}
enum SubscriptionTier {
  FREE
  STARTER
  PRO
  BUSINESS
  ENTERPRISE
}
enum MembershipRole {
  OWNER
  ADMIN
  MANAGER
  STAFF
}
enum VehicleStatus {
  AVAILABLE
  RESERVED
  RENTED
  MAINTENANCE
  INACTIVE
}
enum BookingStatus {
  PENDING
  CONFIRMED
  ACTIVE
  COMPLETED
  CANCELLED
  REJECTED
}
enum InspectionType {
  HANDOVER
  RETURN
}
enum FuelLevel {
  EMPTY
  QUARTER
  HALF
  THREE_QUARTERS
  FULL
}
enum VehicleType {
  MOTORCYCLE
  SCOOTER
  SEDAN
  HATCHBACK
  SUV
  MPV
  VAN
  PICKUP
  BUS
  TRUCK
  OTHER
}

model Tenant {
  id           String       @id @default(cuid())
  name         String
  slug         String       @unique
  email        String
  phone        String?
  rentalTerms  String?      @db.Text
  status       TenantStatus @default(TRIAL)
  timezone     String       @default("Asia/Manila")
  currency     String       @default("PHP")
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt
  memberships  Membership[]
  branches     Branch[]
  vehicles     Vehicle[]
  customers    Customer[]
  bookings     Booking[]
  inspections  VehicleInspection[]
  subscription Subscription?
  invitations  TeamInvitation[]
  billingRecords BillingRecord[]
  referralCode String @unique
  referralsSent Referral[] @relation("ReferralReferrer")
  referralReceived Referral? @relation("ReferralReferredTenant")
  referredUsers User[] @relation("UserReferredByTenant")
  rentalPayments RentalPayment[]
  vehicleMaintenances VehicleMaintenance[]
  vehicleServiceRecords VehicleServiceRecord[]
  operatingExpenses OperatingExpense[]
  subscriptionChangeRequests SubscriptionChangeRequest[]
  subscriptionPaymentSubmissions SubscriptionPaymentSubmission[]
}

model User {
  id          String       @id @default(cuid())
  email       String       @unique
  name        String?
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
  memberships Membership[]
  sessions    Session[]
  legalAcceptances LegalAcceptance[]
  referredByTenantId String?
  referredByTenant Tenant? @relation("UserReferredByTenant", fields: [referredByTenantId], references: [id], onDelete: SetNull)
  referredReferral Referral? @relation("ReferralReferredOwner")
  @@index([referredByTenantId])
}

model Membership {
  id        String         @id @default(cuid())
  tenantId  String
  userId    String
  role      MembershipRole @default(STAFF)
  createdAt DateTime       @default(now())
  tenant    Tenant         @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  user      User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@unique([tenantId, userId])
  @@index([userId])
  @@index([tenantId, role])
}

model Plan {
  id             String           @id @default(cuid())
  tier           SubscriptionTier @unique
  name           String
  monthlyPrice   Decimal          @db.Decimal(12, 2)
  maxVehicles    Int?
  maxBranches    Int?
  maxStaff       Int?
  active         Boolean          @default(true)
  subscriptions Subscription[]
}

model Subscription {
  id                 String           @id @default(cuid())
  tenantId           String           @unique
  planId             String
  tier               SubscriptionTier @default(FREE)
  status             String           @default("active")
  currentPeriodStart DateTime?
  currentPeriodEnd   DateTime?
  trialEndsAt        DateTime?
  trialPolicyVersion Int              @default(0)
  trialGraceEndsAt   DateTime?
  trialReminderSentAt DateTime?
  trialExpiredNoticeSentAt DateTime?
  trialReadOnlyNoticeSentAt DateTime?
  referralCreditMonths Int @default(0)
  createdAt          DateTime         @default(now())
  updatedAt          DateTime         @updatedAt
  tenant             Tenant           @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  plan               Plan             @relation(fields: [planId], references: [id])
}

model Branch {
  id        String   @id @default(cuid())
  tenantId  String
  name      String
  code      String?
  address   String?
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  tenant    Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  vehicles  Vehicle[]
  bookings  Booking[]
  operatingExpenses OperatingExpense[]
  @@unique([tenantId, code])
  @@index([tenantId])
}

model Vehicle {
  id              String        @id @default(cuid())
  tenantId        String
  branchId        String?
  type            VehicleType
  make            String
  model           String
  year            Int?
  plateNumber     String
  color           String?
  seats           Int?
  transmission    String?
  dailyRate       Decimal       @db.Decimal(12, 2)
  securityDeposit Decimal       @default(0) @db.Decimal(12, 2)
  status          VehicleStatus @default(AVAILABLE)
  notes           String?
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt
  tenant          Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  branch          Branch?       @relation(fields: [branchId], references: [id], onDelete: SetNull)
  bookingItems    BookingItem[]
  inspections     VehicleInspection[]
  maintenances    VehicleMaintenance[]
  serviceRecords  VehicleServiceRecord[]
  operatingExpenses OperatingExpense[]
  @@unique([tenantId, plateNumber])
  @@index([tenantId, status])
  @@index([tenantId, branchId])
}

model Customer {
  id        String   @id @default(cuid())
  tenantId  String
  name      String
  email     String?
  phone     String
  licenseNo String?
  address   String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  tenant    Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  bookings  Booking[]
  @@index([tenantId, phone])
  @@index([tenantId, email])
}

model Booking {
  id          String        @id @default(cuid())
  tenantId    String
  branchId    String?
  customerId  String
  reference   String
  status      BookingStatus @default(PENDING)
  startAt     DateTime
  endAt       DateTime
  totalAmount Decimal       @db.Decimal(12, 2)
  notes       String?
  rentalTermsSnapshot String? @db.Text
  rentalTermsVersion String?
  rentalTermsAcceptedAt DateTime?
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt
  tenant      Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  branch      Branch?       @relation(fields: [branchId], references: [id], onDelete: SetNull)
  customer    Customer      @relation(fields: [customerId], references: [id])
  items       BookingItem[]
  messages    BookingMessage[]
  payments    RentalPayment[]
  automationNotices BookingAutomationNotice[]
  documents   BookingDocument[]
  inspections VehicleInspection[]
  publicTokenHash String? @unique
  @@unique([tenantId, reference])
  @@index([tenantId, startAt, endAt])
  @@index([tenantId, status])
}

model BookingItem {
  id        String   @id @default(cuid())
  bookingId String
  vehicleId String
  rate      Decimal  @db.Decimal(12, 2)
  booking   Booking  @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  vehicle   Vehicle  @relation(fields: [vehicleId], references: [id])
  @@unique([bookingId, vehicleId])
  @@index([vehicleId])
}


model EmailOtp {
  id         String   @id @default(cuid())
  email      String
  codeHash   String
  expiresAt  DateTime
  attempts   Int      @default(0)
  consumedAt DateTime?
  referralCode String?
  createdAt  DateTime @default(now())
  @@index([email, createdAt])
  @@index([expiresAt])
}

model Session {
  id        String   @id @default(cuid())
  tokenHash String   @unique
  userId    String
  expiresAt DateTime
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@index([userId, expiresAt])
  @@index([expiresAt])
}

model BookingMessage {
  id        String   @id @default(cuid())
  bookingId String
  sender    String
  body      String
  createdAt DateTime @default(now())
  booking   Booking  @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  @@index([bookingId, createdAt])
}

model BookingDocument {
  id           String   @id @default(cuid())
  bookingId    String
  kind         String
  pathname     String   @unique
  fileName     String
  contentType  String
  size         Int
  reviewStatus String   @default("PENDING")
  reviewedAt   DateTime?
  createdAt    DateTime @default(now())
  booking      Booking  @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  @@index([bookingId, reviewStatus])
}


model VehicleInspection {
  id             String           @id @default(cuid())
  tenantId       String
  bookingId      String
  vehicleId      String
  type           InspectionType
  odometerKm     Int
  fuelLevel      FuelLevel
  conditionNotes String
  damageNotes    String?
  inspectedAt    DateTime         @default(now())
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt
  tenant         Tenant           @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  booking        Booking          @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  vehicle        Vehicle          @relation(fields: [vehicleId], references: [id])
  photos         VehicleInspectionPhoto[]
  @@unique([bookingId, vehicleId, type])
  @@index([tenantId, inspectedAt])
  @@index([vehicleId, inspectedAt])
}

model VehicleInspectionPhoto {
  id           String           @id @default(cuid())
  inspectionId String
  pathname     String           @unique
  fileName     String
  contentType  String
  size         Int
  createdAt    DateTime         @default(now())
  inspection   VehicleInspection @relation(fields: [inspectionId], references: [id], onDelete: Cascade)
  @@index([inspectionId, createdAt])
}


model LegalAcceptance {
  id             String   @id @default(cuid())
  userId         String
  termsVersion   String
  privacyVersion String
  acceptedAt     DateTime @default(now())
  ipAddress      String?
  userAgent      String?
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@unique([userId, termsVersion, privacyVersion])
  @@index([userId, acceptedAt])
}


model TeamInvitation {
  id              String         @id @default(cuid())
  tenantId        String
  email           String
  role            MembershipRole @default(STAFF)
  tokenHash       String         @unique
  invitedByUserId String
  expiresAt       DateTime
  acceptedAt      DateTime?
  createdAt       DateTime       @default(now())
  tenant          Tenant         @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId, email, acceptedAt])
  @@index([expiresAt])
}

model PlatformAuditLog {
  id          String   @id @default(cuid())
  actorUserId String
  actorEmail  String
  action      String
  entityType  String
  entityId    String
  details     Json?
  createdAt   DateTime @default(now())

  @@index([createdAt])
  @@index([actorUserId, createdAt])
  @@index([entityType, entityId, createdAt])
}



model Referral {
  id                 String   @id @default(cuid())
  referrerTenantId   String
  referredTenantId   String   @unique
  referredOwnerUserId String  @unique
  code               String
  status             String   @default("PENDING")
  registeredAt       DateTime
  expiresAt          DateTime
  qualifiedAt        DateTime?
  rewardedAt         DateTime?
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt
  referrerTenant     Tenant   @relation("ReferralReferrer", fields: [referrerTenantId], references: [id], onDelete: Cascade)
  referredTenant     Tenant   @relation("ReferralReferredTenant", fields: [referredTenantId], references: [id], onDelete: Cascade)
  referredOwner      User     @relation("ReferralReferredOwner", fields: [referredOwnerUserId], references: [id], onDelete: Cascade)
  @@index([referrerTenantId, status, createdAt])
  @@index([status, expiresAt])
}

model BillingRecord {
  id          String   @id @default(cuid())
  tenantId    String
  description String
  reference   String?  @unique
  amount      Decimal  @db.Decimal(12, 2)
  currency    String   @default("PHP")
  status      String   @default("PENDING")
  issuedAt    DateTime @default(now())
  dueAt       DateTime?
  paidAt      DateTime?
  createdAt   DateTime @default(now())
  tenant      Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  @@index([tenantId, issuedAt])
  @@index([tenantId, status])
}

model SubscriptionChangeRequest {
  id             String   @id @default(cuid())
  tenantId       String
  requestedTier  SubscriptionTier
  currentTier    SubscriptionTier
  status         String   @default("PENDING")
  note           String?  @db.Text
  requestedById  String
  reviewedById   String?
  reviewedAt     DateTime?
  createdAt      DateTime @default(now())
  tenant         Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  @@index([tenantId, createdAt])
  @@index([status, createdAt])
}



model SubscriptionPaymentMethod {
  id             String   @id @default(cuid())
  key            String   @unique
  label          String
  accountName    String?
  instructions   String?  @db.Text
  qrImageData    String?  @db.Text
  qrContentType  String?
  enabled        Boolean  @default(false)
  sortOrder      Int      @default(0)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  submissions    SubscriptionPaymentSubmission[]
}

model SubscriptionPaymentSubmission {
  id                         String   @id @default(cuid())
  tenantId                   String
  methodId                   String
  methodLabel                String
  accountName                String?
  reference                  String
  amount                     Decimal  @db.Decimal(12, 2)
  paidAt                     DateTime
  receiptData                String?  @db.Text
  receiptContentType         String?
  status                     String   @default("PENDING")
  provisionalUntil           DateTime
  previousTenantStatus       TenantStatus
  previousSubscriptionStatus String
  previousCurrentPeriodStart DateTime?
  previousCurrentPeriodEnd   DateTime?
  previousTrialEndsAt        DateTime?
  previousTrialGraceEndsAt   DateTime?
  reviewedById               String?
  reviewedAt                 DateTime?
  rejectionReason            String?  @db.Text
  createdAt                  DateTime @default(now())
  updatedAt                  DateTime @updatedAt
  tenant                     Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  method                     SubscriptionPaymentMethod @relation(fields: [methodId], references: [id], onDelete: Restrict)
  @@unique([methodId, reference])
  @@index([status, provisionalUntil])
  @@index([tenantId, createdAt])
}

model RentalPayment {
  id        String   @id @default(cuid())
  tenantId  String
  bookingId String
  amount    Decimal  @db.Decimal(12, 2)
  currency  String   @default("PHP")
  method    String   @default("CASH")
  kind      String   @default("PAYMENT")
  reference String?
  notes     String?  @db.Text
  receivedAt DateTime @default(now())
  createdAt DateTime @default(now())
  tenant    Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  booking   Booking  @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  @@index([tenantId, receivedAt])
  @@index([bookingId, receivedAt])
}

model BookingAutomationNotice {
  id           String   @id @default(cuid())
  bookingId    String
  noticeKey    String   @unique
  noticeType   String
  status       String   @default("PENDING")
  scheduledFor DateTime
  sentAt       DateTime?
  lastError    String?  @db.Text
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  booking      Booking  @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  @@index([status, scheduledFor])
}


model VehicleMaintenance {
  id          String   @id @default(cuid())
  tenantId    String
  vehicleId   String
  title       String
  description String?  @db.Text
  status      String   @default("SCHEDULED")
  startAt     DateTime
  endAt       DateTime
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  tenant      Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  vehicle     Vehicle  @relation(fields: [vehicleId], references: [id], onDelete: Cascade)
  serviceRecords VehicleServiceRecord[]
  @@index([tenantId, startAt, endAt])
  @@index([vehicleId, startAt, endAt])
}

model VehicleServiceRecord {
  id           String   @id @default(cuid())
  tenantId     String
  vehicleId    String
  maintenanceId String?
  serviceType  String
  description  String?  @db.Text
  odometerKm   Int?
  cost         Decimal  @default(0) @db.Decimal(12, 2)
  performedAt  DateTime @default(now())
  createdAt    DateTime @default(now())
  tenant       Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  vehicle      Vehicle  @relation(fields: [vehicleId], references: [id], onDelete: Cascade)
  maintenance  VehicleMaintenance? @relation(fields: [maintenanceId], references: [id], onDelete: SetNull)
  @@index([tenantId, performedAt])
  @@index([vehicleId, performedAt])
}

model OperatingExpense {
  id          String   @id @default(cuid())
  tenantId    String
  branchId    String?
  vehicleId   String?
  category    String
  description String
  amount      Decimal  @db.Decimal(12, 2)
  currency    String   @default("PHP")
  incurredAt  DateTime @default(now())
  reference   String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  tenant      Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  branch      Branch?  @relation(fields: [branchId], references: [id], onDelete: SetNull)
  vehicle     Vehicle? @relation(fields: [vehicleId], references: [id], onDelete: SetNull)
  @@index([tenantId, incurredAt])
  @@index([tenantId, category, incurredAt])
  @@index([vehicleId, incurredAt])
}
